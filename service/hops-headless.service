# hops-headless.service — HEADLESS Linux server (no display).
#
# Runs the hops daemon as a background service with no graphical session, so a
# server can act as a KVM node you cross onto and control over the network.
#
# Install (as a user service):
#   mkdir -p ~/.config/systemd/user
#   cp hops-headless.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hops-headless.service
#
# Start at BOOT without an interactive login (the point of a headless box):
#   sudo loginctl enable-linger "$USER"
#
# REQUIRES A RUNNING GRAPHICAL SESSION. "Headless" here means no monitor and no
# interactive login — NOT no display server. Every Linux emulation backend needs
# one: wlroots calls Connection::connect_to_env() (WAYLAND_DISPLAY), x11 calls
# XOpenDisplay (DISPLAY), and libei/xdg-desktop-portal go through the portal.
# There is no /dev/uinput backend in this codebase, so on a box with no display
# server the daemon starts, discovers and pairs, and then cannot inject.
#
# Do NOT add yourself to the `input` group for this. Earlier revisions of this
# file said to; it grants read access to every /dev/input/event* — system-wide
# keystroke capture, on the machine running a KVM — for a capability hops does
# not have and does not use.
#
# Configure it over SSH after it's running: `hops tui` (needs a --features tui
# build), `hops cli ...`, or edit ~/.config/lan-mouse/config.toml. See
# service/README.md.

[Unit]
Description=hops — software KVM daemon (headless)
Documentation=https://github.com/jtjones09/grabbr-hops
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/hops daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
