// hops — the GUI surface. Composes the design tokens (theme.slint) and the
// atoms (widgets.slint) into the control panel. Rust sets Theme.index, the status
// fields, the two lists, and the live pairing-fp; the callbacks send FrontendRequests.

import { Theme, Type, Space, Radius, Motion, Size } from "theme.slint";
import { Card, Separator, Dot, Chip, StatChip, SectionTitle, PillButton, TextField, Toggle, NumberButton, ChoiceRow } from "widgets.slint";
import { OnboardingWindow } from "onboarding.slint";
import { LayoutCanvas, CanvasBox } from "layout_canvas.slint";
import { HopsTray } from "tray.slint";
import { ScrollView } from "std-widgets.slint";

// re-export so Rust can select the active palette via `ui.global::<Theme>()`.
// OnboardingWindow/CanvasBox/HopsTray are re-exported here too (not compiled as
// their own separate slint_build entry points) so they share this SAME generated
// `Theme`/`ThemeColors` Rust type — two independent `slint_build::compile()`
// calls over files that both import theme.slint would otherwise produce two
// nominally distinct types.
export { Theme, OnboardingWindow, CanvasBox, HopsTray }

// The colour family of a device's dot, from `Connection::tone` (#148).
export enum DotTone { quiet, good, warn, bad }

// One unified device (a physical peer). `has-send` = we dial it (outgoing
// facet: pos/active/edit/delete); otherwise it's a receive-only trusted peer
// (fingerprint + revoke). A machine that is both renders once, as a send row.
// Built from `AppModel::devices()` in the Rust side.
export struct DeviceRow {
    handle: string,      // ClientHandle (u64 as text — Slint int is only i32); "" if receive-only
    name: string,        // display label
    addr: string,        // "ip:port" / "unresolved" (send facet)
    pos: string,         // "left" / "right" / … (send facet)
    active: bool,        // switched on here: the toggle (send facet)
    tone: DotTone,       // the dot, and the status words' colour, from the
                         // device's one connection state (#148)
    status: string,      // that state in words
    has-send: bool,      // has an outgoing (send-to) facet
    fingerprint: string, // short fingerprint (display)
    fp-full: string,     // full fingerprint (for revoke)
    pin: string,         // the send facet's pin, "" if none: what delete and
                         // rename carry, so the daemon can refuse them once
                         // the device is pinned to another machine (#94)
    trusted: bool,       // this machine holds a pairing with it, either way:
                         // it can be renamed and removed by fingerprint
    clipboard: string,   // which way the clipboard goes, for the edit panel,
                         // or "" when no pairing holds one (#182)
    clipboard-on: bool,  // some direction is on, so it can be switched off
    pair-again: bool,    // paired with an older version and not since: it
                         // grants nothing, and can be added again or
                         // removed by fingerprint (#231)
}

// A machine announcing itself on the LAN. NOT a device and NOT an identity —
// the fingerprint is a claim by whatever is on the network, shown so a row can
// be labelled. Adding one dials it and goes through the ordinary approval
// prompt, exactly as typing an address does (#136).
export struct DiscoveredRow {
    label: string,        // advertised name, display only
    fingerprint: string,  // short claimed fingerprint, display only
    ips: string,          // comma-separated addresses, for the add callback
    addr-summary: string, // "10.0.0.5 +2 more" for display
    port: string,
}

// Something that should run and cannot, and what to change: capture (#91)
// and emulation each have one. Stays while it is true; not dismissible.
component ProblemBanner inherits Rectangle {
    in property <string> text;
    // Whether this Mac can take the user to the setting that mends it: the
    // problem is a missing permission (#169).
    in property <bool> settings;
    callback open-settings();
    vertical-stretch: 0;
    background: Theme.c.warn.transparentize(0.9);
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Theme.c.warn.transparentize(0.55);
    HorizontalLayout {
        padding: Space.md;
        spacing: Space.md;
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.c.foreground;
            font-size: Type.small;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if root.settings: VerticalLayout {
            alignment: center;
            PillButton {
                text: "open settings";
                clicked => { root.open-settings(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "hops";
    default-font-family: Type.sans;
    default-font-size: Type.body;
    // Fixed opening size (560x690) via preferred-* ONLY. Do NOT lock it with
    // min == max: that constant-folds the window's size property, and then any
    // runtime size change (a winit resize/DPI event) panics "Constant property
    // being changed" in i-slint-core and ABORTS the process (release is
    // panic=abort) — the window "vanishes". preferred-height (vs the old
    // content-hug with no preferred-height) is what stops the collapse; the
    // device/trusted lists SCROLL within it (ScrollView below) so any machine
    // count fits. True non-resizability, if wanted, must come from the winit
    // backend accessor, never a Slint min==max property lock.
    preferred-width: 560px;
    preferred-height: 690px;
    background: Theme.c.background;

    // The daemon's only way to tell the user something failed. Kept dismissible
    // and seq-gated: dismissing hides THIS notice, a new one re-raises the bar.
    // Machines announcing themselves on the LAN that are not already added or
    // trusted. Not devices and not identities — see DiscoveredRow (#136).
    in property <[DiscoveredRow]> discovered: [];
    // Whether hops is actually looking. An empty list alone cannot say whether
    // discovery is off, still searching, or has genuinely found nothing — and
    // rendering the same silence for all three is how a working feature looks
    // broken (#141).
    in property <bool> discovery-active: false;
    // What the network section says while it lists nobody: that hops is
    // looking, or, once nothing has answered for a while, what on this
    // system can keep hops from hearing other machines (#149).
    in property <string> discovery-empty: "looking — no other machines yet. They need hops running and to be on this network.";
    in property <string> notice: "";
    in property <int> notice-seq: 0;
    property <int> dismissed-seq: 0;
    // One-off news for the user, such as that the app restarted its service
    // because it ran another build (#222). News, not a failure: the red
    // banner above carries errors only (#150).
    in property <string> info: "";
    property <bool> info-dismissed: false;
    in property <bool> connected: false;
    // What is wrong with the service, or empty: why the service the app
    // started did not come up, or that the daemon runs another build than
    // this app. Not dismissible: it stays while it is true.
    in property <string> service-problem: "";
    in property <string> capture: "—";
    // Why capture, which should run, does not, or empty (#91). Stays while
    // it is true; not dismissible.
    in property <string> capture-problem: "";
    // Whether this Mac can take the user to the setting that mends it: the
    // problem is a missing permission (#169).
    in property <bool> capture-settings: false;
    in property <string> emulation: "—";
    // Why emulation, which should run, does not, or empty: on a Mac that is
    // only controlled, the permission it lacks.
    in property <string> emulation-problem: "";
    in property <bool> emulation-settings: false;
    in property <string> port: "—";
    // This machine listens on no port: it only dials out (#15).
    in property <bool> dials-out-only: false;
    in property <string> fingerprint: "—";
    in property <[DeviceRow]> devices: [];
    in property <string> pairing-fp: "";
    // The name typed into the pairing card. Held here rather than only in the
    // field so Rust can clear it when the card changes machine: a name typed
    // for one machine must never be sent to approve another (#168). `in-out`
    // because the field writes it and Rust clears it.
    in-out property <string> pairing-name: "";
    // The card's two questions (#220, #182), answered for the machine on it
    // and cleared by Rust when it changes machine, as the name is. Which way
    // control goes: an index into `controller-choices`, or -1 until someone
    // chooses, and approving waits for it. The clipboard: off until switched on.
    in-out property <int> pairing-controller: -1;
    in-out property <bool> pairing-clipboard: false;
    // The three answers, in the words every frontend uses; Rust sets them.
    in property <[string]> controller-choices: [
        "This machine controls that one",
        "That machine controls this one",
        "Each controls the other",
    ];
    // true when WE dialled out and found this untrusted receiver, rather than it
    // connecting to us. A console verb can cause the former, so the card must not
    // present it as a peer knocking (#61).
    in property <bool> pairing-from-our-dial: false;
    // the address that actually answered our dial — the user typed one, and the
    // machine that replies is not always the one they meant (#93)
    in property <string> pairing-addr: "";
    // What the card for our own dial says: the device added here that it
    // dialled, and when to deny it (#93). Rust fills it; empty for a knock.
    in property <string> pairing-dialled: "";
    // The number card (#11, #167). Both machines approved, and a person must
    // compare the six digits they arrived at over this connection. The adding
    // machine shows the number and confirms; the machine being added picks it
    // from three, and a wrong pick ends the attempt. Rust fills these from the
    // daemon's check; `in-out` so render_png can show every state.
    in-out property <string> check-fp: "";
    in-out property <string> check-from: "";
    in-out property <bool> check-show: false;
    in-out property <string> check-number: "";
    in-out property <[string]> check-choices: [];
    in-out property <bool> check-answered: false;

    // `in-out` so the render_png self-review harness can open it for a look —
    // the same reason confirm-delete-handle is. A confirm state you cannot
    // render is a confirm state nobody checks.
    in-out property <string> confirm-revoke-fp: "";
    // `in-out` so the render_png self-review harness can open it for a look.
    in-out property <string> confirm-delete-handle: "";
    // The row's pin when delete was armed. The delete carries it, and Rust
    // clears both once the device behind the handle changes (#94).
    in-out property <string> confirm-delete-pin: "";
    // handle of the device being renamed ("" = none). The rename FIELD lives
    // in a single shared panel below the list, NOT inline per-row — `devices`
    // is a brand-new VecModel every ~250ms poll tick, so a TextField inside
    // the `for` loop would have its in-progress typing wiped out on the next
    // tick along with the rest of that row's instance. A property compared
    // against `d.handle` (like this one, and confirm-revoke-fp/
    // confirm-delete-handle above) is safe because it lives on `root`, outside
    // the loop, and is just re-read fresh each time a row re-renders.
    // `in-out` so the render_png self-review harness can open it for a look.
    in-out property <string> editing-device: "";
    // The row's pin when its rename opened, carried like confirm-delete-pin.
    in-out property <string> editing-pin: "";
    // The device being edited is one this machine dials, so it has an
    // address to change as well as a name (#13).
    in-out property <bool> editing-send: false;
    // What is typed into its address field, on `root` so cancel can clear a
    // field that exists only while `editing-send` holds.
    in-out property <string> editing-address: "";
    // The edit panel is asking whether to turn the device's clipboard off.
    // "turn on" puts it back (#182).
    in-out property <bool> confirm-clipboard-off: false;
    // `in-out` (not a plain internal property) so the render_png self-review
    // harness can open these overlays from outside for a look — not used by the
    // real app's Rust side, which only ever reads them indirectly via clicks.
    in-out property <bool> show-settings: false;
    in-out property <bool> show-add-device: false;
    // Seconds left in which a pairing prompt may appear on this machine (#195).
    // Zero while the window is closed. `in-out` so render_png can show it.
    in-out property <int> pairing-seconds: 0;
    // seeded from `free-position` when the panel opens — defaulting every add to
    // "left" meant the second device silently evicted the first
    property <string> add-device-position: "left";
    in property <string> free-position: "left";
    // The theme colour of a device dot's tone (#148).
    pure function tone-color(tone: DotTone) -> color {
        if tone == DotTone.good {
            return Theme.c.success;
        }
        if tone == DotTone.warn {
            return Theme.c.warn;
        }
        if tone == DotTone.bad {
            return Theme.c.error;
        }
        return Theme.c.muted;
    }

    // ONE submit path for the add form, so the button and the Enter key cannot
    // drift apart. Enter previously did nothing at all, even though it works in
    // the rename box one panel below.
    property <string> add-name-text;
    property <string> add-port-text;
    function submit-add-device() {
        root.create-device(root.add-name-text, root.add-port-text, root.add-device-position);
        root.add-name-text = "";
        root.add-port-text = "";
        root.add-device-position = root.free-position;
        root.show-add-device = false;
    }
    // `in-out`: Rust sets both together, once, when the canvas opens — NOT
    // re-pushed by the poll timer (see layout_canvas.slint's header note on
    // why a drag would otherwise get fought by the next live update).
    in-out property <bool> show-layout-canvas: false;
    in-out property <[CanvasBox]> canvas-boxes: [];

    callback enable-input();
    callback open-capture-settings();
    callback open-emulation-settings();
    callback activate-device(string /* handle */, bool /* active */);
    callback reposition-device(string /* handle */, string /* new position */);
    callback rename-device(string /* handle */, string /* pin */, string /* new name */);
    // A device this machine dials, at a new hostname or address. Its pin
    // stays: only the same machine is accepted there (#99).
    callback readdress-device(string /* handle */, string /* pin */, string /* address */);
    callback delete-device(string /* handle */, string /* pin */);
    callback revoke(string /* full fingerprint */);
    callback disable-clipboard(string /* full fingerprint */);
    callback enable-clipboard(string /* full fingerprint */);
    callback approve-pairing(string /* name */, string /* full fingerprint */);
    callback deny-pairing(string /* full fingerprint */);
    // the number shown, to confirm it, or the one picked from three
    callback confirm-pairing(string /* full fingerprint */, string /* number */);
    // "cancel" or "none of these": end the pairing, trust nothing
    callback cancel-pairing(string /* full fingerprint */);
    callback set-theme(int /* palette index */);
    callback create-device(string /* name */, string /* port */, string /* position */);
    // Add device was opened: pairing prompts may appear here for two minutes.
    callback open-pairing();
    // add a machine picked off the network list: label, comma-separated IPs,
    // port, edge. Discovery supplies the address, never the trust (#136).
    callback add-discovered(string /* label */, string /* ips */, string /* port */, string /* position */);
    callback switch-interface();
    // Whether the other front-end can replace this one in place. Only a Unix
    // exec can; elsewhere the button did nothing and said nothing (#173).
    in property <bool> can-switch-interface: true;
    callback open-layout-canvas();
    callback update-device-geometry(string /* handle */, float /* x */, float /* y */);

    VerticalLayout {
        padding: Space.xxl;
        spacing: Space.lg;

        // --- header: wordmark + inline connection ------------------------------
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "hops";
                font-size: Type.heading;
                font-weight: Type.bold;
                color: Theme.c.foreground;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: Space.md;
                HorizontalLayout {
                    spacing: Space.sm;
                    VerticalLayout {
                        alignment: center;
                        Dot { tint: root.connected ? Theme.c.success : Theme.c.warn; }
                    }
                    Text {
                        text: root.connected ? "connected" : "connecting";
                        color: root.connected ? Theme.c.success : Theme.c.warn;
                        font-size: Type.small;
                        font-weight: Type.semibold;
                        vertical-alignment: center;
                    }
                }
                PillButton {
                    text: "settings";
                    ghost: true;
                    clicked => { root.show-settings = true; }
                }
            }
        }

        // --- status line (plain inline, no boxes) ------------------------------
        HorizontalLayout {
            spacing: Space.lg;
            alignment: start;
            HorizontalLayout {
                spacing: 5px;
                Text { text: "capture"; color: Theme.c.muted; font-size: Type.small; }
                // Failed is not off: capture should run and cannot (#91).
                Text {
                    text: root.capture == "enabled" ? "on" : (root.capture == "failed" ? "failed" : "off");
                    color: root.capture == "enabled" ? Theme.c.success : (root.capture == "failed" ? Theme.c.warn : Theme.c.muted);
                    font-size: Type.small;
                    font-weight: Type.semibold;
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Text { text: "emulation"; color: Theme.c.muted; font-size: Type.small; }
                // Failed is not off, as for capture.
                Text {
                    text: root.emulation == "enabled" ? "on" : (root.emulation == "failed" ? "failed" : "off");
                    color: root.emulation == "enabled" ? Theme.c.success : (root.emulation == "failed" ? Theme.c.warn : Theme.c.muted);
                    font-size: Type.small;
                    font-weight: Type.semibold;
                }
            }
            // A machine that only dials out listens on no port (#15): its
            // configured port is not one anything can reach.
            if root.dials-out-only: Text {
                text: "dials out only";
                color: Theme.c.muted;
                font-size: Type.small;
                font-weight: Type.semibold;
            }
            if !root.dials-out-only: HorizontalLayout {
                spacing: 5px;
                Text { text: "port"; color: Theme.c.muted; font-size: Type.small; }
                Text {
                    text: root.port;
                    color: Theme.c.foreground;
                    font-family: Type.mono;
                    font-size: Type.small;
                    letter-spacing: Type.mono-tracking;
                }
            }
            // Only with a daemon to ask: without one input is off because
            // nothing is running, and the button could only be refused (#34).
            if root.connected && (root.capture != "enabled" || root.emulation != "enabled"): PillButton {
                text: "enable input";
                primary: true;
                clicked => { root.enable-input(); }
            }
        }

        // --- capture that should run and cannot, and what to change (#91) ------
        if root.capture-problem != "": ProblemBanner {
            text: root.capture-problem;
            settings: root.capture-settings;
            open-settings => { root.open-capture-settings(); }
        }
        if root.emulation-problem != "": ProblemBanner {
            text: root.emulation-problem;
            settings: root.emulation-settings;
            open-settings => { root.open-emulation-settings(); }
        }

        // --- the service: a start that did not come up, or another build ------
        if root.service-problem != "": Rectangle {
            vertical-stretch: 0;
            background: Theme.c.warn.transparentize(0.9);
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Theme.c.warn.transparentize(0.55);
            HorizontalLayout {
                padding: Space.md;
                Text {
                    text: root.service-problem;
                    color: Theme.c.foreground;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
        }

        // Everything between the fixed header/status and the fixed footer
        // scrolls, so the window stays a fixed size no matter how many
        // devices are paired (few -> some slack above the footer; many ->
        // it scrolls). See the Window size note above.
        ScrollView {
            vertical-stretch: 1;
            // A ScrollView reports a tiny intrinsic height by design — it expects
            // its parent to give it a size, not to be asked how tall it wants to
            // be. Without a floor here the Window's NATURAL size collapses to
            // 381x223 (measured), which is #30's "opens as just a title bar",
            // and the only thing standing between the user and that was a
            // set_size() call racing the first layout pass — which it does not
            // always win. `vertical-stretch: 1` above lets it grow; this stops
            // it shrinking. Not a fixed height: the window stays resizable and
            // the lists still scroll inside it.
            min-height: 470px;
            // 512 = the 560px design width minus the root layout's Space.xxl
            // padding on both sides, so the window's natural WIDTH also lands
            // on 560 instead of collapsing to 381 (measured).
            min-width: 512px;
            VerticalLayout {
                spacing: Space.lg;
                alignment: start;
                // --- info: news that is not a failure ---------------------------------
                if root.info != "" && !root.info-dismissed: Rectangle {
                    vertical-stretch: 0;
                    background: Theme.c.surface-raised;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Theme.c.border;
                    HorizontalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.info;
                                color: Theme.c.foreground;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            PillButton {
                                text: "dismiss";
                                ghost: true;
                                clicked => { root.info-dismissed = true; }
                            }
                        }
                    }
                }

                // --- notice: the daemon's only channel for "that didn't work" ---------
                // Before this existed, an unresolvable name, a refused trust
                // change, a failed config write and a rejected IPC token were all
                // log lines the user never saw.
                if root.notice != "" && root.notice-seq != root.dismissed-seq: Rectangle {
                    vertical-stretch: 0;
                    background: Theme.c.error.transparentize(0.9);
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Theme.c.error.transparentize(0.55);
                    HorizontalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.notice;
                                color: Theme.c.foreground;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            PillButton {
                                text: "dismiss";
                                ghost: true;
                                clicked => { root.dismissed-seq = root.notice-seq; }
                            }
                        }
                    }
                }

                // --- pairing request ---------------------------------------------------
                // Two ways to get here, and they are NOT the same event (#61):
                //   inbound       — a peer connected to us, unsolicited
                //   our own dial  — we went looking, because something asked us to
                // The second can be caused by a console holding the IPC token, so the
                // card says which, and — for the dial case — states the falsifier: if
                // you did not just ask for this, something else did.
                if root.pairing-fp != "": Rectangle {
                    vertical-stretch: 0;
                    background: Theme.c.warn.transparentize(0.9);
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Theme.c.warn.transparentize(0.55);
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        Text {
                            text: root.pairing-from-our-dial
                                ? "we dialled this device"
                                : "pairing request";
                            color: Theme.c.warn;
                            font-size: Type.small;
                            font-weight: Type.semibold;
                        }
                        if root.pairing-from-our-dial: Text {
                            text: root.pairing-dialled;
                            color: Theme.c.foreground;
                            font-size: Type.caption;
                            wrap: word-wrap;
                        }
                        if root.pairing-addr != "": Text {
                            // our dial: the address that answered (#93);
                            // a knock: the address it came from (#83)
                            text: root.pairing-from-our-dial
                                ? root.pairing-addr + " answered"
                                : "from " + root.pairing-addr;
                            color: Theme.c.foreground;
                            font-family: Type.mono;
                            font-size: Type.caption;
                            letter-spacing: Type.mono-tracking;
                        }
                        Text {
                            text: root.pairing-fp;
                            color: Theme.c.muted;
                            font-family: Type.mono;
                            font-size: Type.caption;
                            letter-spacing: Type.mono-tracking;
                            overflow: elide;
                        }
                        // Asked, never assumed (#220): nothing is chosen until
                        // a click, and "trust & name" waits for one.
                        Text {
                            text: "Which machine is in control?";
                            color: Theme.c.foreground;
                            font-size: Type.small;
                            font-weight: Type.semibold;
                        }
                        for choice[i] in root.controller-choices: ChoiceRow {
                            text: choice;
                            selected: root.pairing-controller == i;
                            clicked => { root.pairing-controller = i; }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.pairing-clipboard;
                                    toggled(on) => { root.pairing-clipboard = on; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.pairing-clipboard
                                        ? "Share the clipboard: yes, the way control goes"
                                        : "Share the clipboard: no";
                                    color: root.pairing-clipboard
                                        ? Theme.c.foreground
                                        : Theme.c.muted;
                                    font-size: Type.small;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            // Rust clears the name once an approval is sent, and
                            // refuses one for a machine the card only just showed.
                            TextField {
                                placeholder: "name this device";
                                horizontal-stretch: 1;
                                text <=> root.pairing-name;
                                accepted => {
                                    root.approve-pairing(root.pairing-name, root.pairing-fp);
                                }
                            }
                            PillButton {
                                text: "trust & name";
                                primary: true;
                                enabled: root.pairing-controller >= 0;
                                clicked => {
                                    root.approve-pairing(root.pairing-name, root.pairing-fp);
                                }
                            }
                            PillButton {
                                text: "deny";
                                clicked => { root.deny-pairing(root.pairing-fp); }
                            }
                        }
                        // Says why "trust & name" waits, as the TUI does.
                        if root.pairing-controller < 0: Text {
                            text: "Choose which machine is in control to trust it.";
                            color: Theme.c.muted;
                            font-size: Type.small;
                            wrap: word-wrap;
                        }
                    }
                }

                // --- the number ---------------------------------------------------------
                // After both approvals. The adding machine shows the number; the one
                // being added asks which of three it sees. Nothing moves until both
                // machines have answered.
                if root.check-fp != "": Rectangle {
                    vertical-stretch: 0;
                    background: Theme.c.accent.transparentize(0.9);
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Theme.c.accent.transparentize(0.55);
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        Text {
                            text: root.check-show
                                ? "pairing · confirm the number"
                                : "pairing · pick the number";
                            color: Theme.c.accent;
                            font-size: Type.small;
                            font-weight: Type.semibold;
                        }
                        Text {
                            text: root.check-from;
                            color: Theme.c.muted;
                            font-family: Type.mono;
                            font-size: Type.caption;
                            letter-spacing: Type.mono-tracking;
                            overflow: elide;
                        }
                        if root.check-show: Text {
                            text: root.check-number;
                            color: Theme.c.foreground;
                            font-family: Type.mono;
                            font-size: 32px;
                            font-weight: Type.bold;
                            letter-spacing: 2px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.check-answered
                                ? (root.check-show
                                    ? "Confirmed here. Waiting for the other machine to pick it."
                                    : "Picked. Waiting for the other machine to confirm.")
                                : (root.check-show
                                    ? "The other machine asks which of three numbers it sees. "
                                        + "Once this one is picked there, confirm here."
                                    : "Which number does the other machine show? A wrong pick "
                                        + "ends the pairing.");
                            color: Theme.c.muted;
                            font-size: Type.caption;
                            wrap: word-wrap;
                        }
                        if !root.check-show && !root.check-answered: HorizontalLayout {
                            spacing: Space.sm;
                            alignment: center;
                            for n in root.check-choices: NumberButton {
                                text: n;
                                clicked => { root.confirm-pairing(root.check-fp, n); }
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            alignment: end;
                            if root.check-show && !root.check-answered: PillButton {
                                text: "confirm";
                                primary: true;
                                clicked => { root.confirm-pairing(root.check-fp, root.check-number); }
                            }
                            PillButton {
                                text: root.check-show || root.check-answered ? "cancel" : "none of these";
                                clicked => { root.cancel-pairing(root.check-fp); }
                            }
                        }
                    }
                }

                // --- devices ------------------------------------------------------------
                HorizontalLayout {
                    alignment: space-between;
                    SectionTitle { text: "devices"; color: Theme.c.accent; }
                    HorizontalLayout {
                        spacing: Space.sm;
                        PillButton {
                            text: "arrange";
                            ghost: true;
                            clicked => { root.open-layout-canvas(); }
                        }
                        PillButton {
                            text: root.show-add-device ? "cancel" : "+ add";
                            ghost: true;
                            clicked => {
                                // opening: preselect an edge nothing is using, so
                                // the second device does not evict the first
                                if !root.show-add-device {
                                    root.add-device-position = root.free-position;
                                    root.open-pairing();
                                }
                                root.show-add-device = !root.show-add-device;
                            }
                        }
                    }
                }
                // Stays after the form is closed: the other machine can still
                // answer until the window runs out, and this is the only sign
                // that it can.
                if root.pairing-seconds > 0: Text {
                    text: "pairing open · " + Math.floor(root.pairing-seconds / 60) + ":"
                        + (Math.mod(root.pairing-seconds, 60) < 10 ? "0" : "")
                        + Math.mod(root.pairing-seconds, 60)
                        + " — open add device on the other machine too";
                    color: Theme.c.muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
                if root.show-add-device: Rectangle {
                    vertical-stretch: 0;
                    background: Theme.c.surface;
                    border-radius: Radius.lg;
                    border-width: 1px;
                    border-color: Theme.c.border;
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        // The easy rung first: click a machine hops already
                        // found. Typing an address is the FALLBACK below, and
                        // the order says so. This block used to sit outside
                        // this panel entirely, so the easy path was pinned
                        // below the device list and on screen permanently,
                        // while the fallback was the only thing behind "add".
                    // --- on your network ---------------------------------------------------
                    // The easiest rung of the pairing ladder: click a machine instead of
                    //
                    // NOTHING here is trusted. The fingerprint is a claim by whatever is on
                    // the LAN, shown so a row is recognisable. "add" dials the machine and
                    // raises the ordinary approval prompt, exactly as a typed address does.
                    // Shown whenever hops is LOOKING, not only when it has found
                    // something. An empty list is ambiguous — off, still searching,
                    // or genuinely nothing — and rendering the same absence for all
                    // three is how a working feature looks broken (#141).
                    if root.discovery-active: VerticalLayout {
                        spacing: 6px;
                        SectionTitle { text: "on your network"; color: Theme.c.accent; }
                        if root.discovered.length == 0: HorizontalLayout {
                            padding: Space.sm;
                            Text {
                                text: root.discovery-empty;
                                color: Theme.c.muted;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                        if root.discovered.length > 0: Card {
                            VerticalLayout {
                                for n in root.discovered: Rectangle {
                                    height: 52px;
                                    border-radius: Radius.md;
                                    nrow := TouchArea {}
                                    background: nrow.has-hover ? Theme.c.surface-raised : transparent;
                                    animate background { duration: Motion.fast; }
                                    HorizontalLayout {
                                        padding-left: Space.md;
                                        padding-right: Space.md;
                                        spacing: Space.md;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: n.label;
                                                color: Theme.c.foreground;
                                                font-weight: Type.medium;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: n.addr-summary + "  " + n.fingerprint;
                                                color: Theme.c.muted;
                                                font-family: Type.mono;
                                                font-size: Type.caption;
                                                letter-spacing: Type.mono-tracking;
                                                overflow: elide;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            PillButton {
                                                text: "add";
                                                clicked => {
                                                    root.add-discovered(
                                                        n.label, n.ips, n.port, root.add-device-position);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                        Separator {}
                        Text {
                            text: "not finding it? enter its address";
                            color: Theme.c.muted;
                            font-size: Type.caption;
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 2;
                                Text {
                                    text: "hostname or IP address";
                                    color: Theme.c.muted;
                                    font-size: Type.caption;
                                }
                                add-name := TextField {
                                    text <=> root.add-name-text;
                                    placeholder: "studio-pc  ·  10.0.0.5";
                                    accepted => { root.submit-add-device(); }
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "port";
                                    color: Theme.c.muted;
                                    font-size: Type.caption;
                                }
                                add-port := TextField {
                                    text <=> root.add-port-text;
                                    placeholder: "4722";
                                    accepted => { root.submit-add-device(); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            Text {
                                text: "position";
                                color: Theme.c.muted;
                                font-size: Type.small;
                                vertical-alignment: center;
                            }
                            for p in ["left", "right", "top", "bottom"]: PillButton {
                                text: p;
                                primary: root.add-device-position == p;
                                clicked => { root.add-device-position = p; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            PillButton {
                                text: "add device";
                                primary: true;
                                clicked => { root.submit-add-device(); }
                            }
                        }
                    }
                }
if root.devices.length > 0 || !root.show-add-device: Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: Space.sm;
                        spacing: 2px;
                        // No daemon: the rows below are what it last said,
                        // not what is, so they are dimmed, inert, and say so
                        // (#34).
                        if !root.connected && root.devices.length > 0: HorizontalLayout {
                            padding: Space.sm;
                            Text {
                                text: "not connected to the hops service — last known devices";
                                color: Theme.c.warn;
                                font-size: Type.small;
                                overflow: elide;
                            }
                        }
                        if root.devices.length == 0: HorizontalLayout {
                            padding: Space.sm;
                            Text {
                                // One sentence, because there is nothing to
                                // point AT any more: what hops found now lives
                                // inside the add panel, so "below" was a promise
                                // of a section that is no longer on screen.
                                text: "no devices yet — click add to see what hops has "
                                    + "found, or accept a pairing request";
                                color: Theme.c.muted;
                                font-size: Type.small;
                            }
                        }
                        for d in root.devices: Rectangle {
                            // Named ONCE, because comparing the raw strings per
                            // guard is a trap: a provisional device (added by
                            // address, never connected) has no fingerprint, so
                            // `confirm-revoke-fp != d.fp-full` is "" != "" —
                            // FALSE — and every control guarded on it silently
                            // vanished. That row lost its position chip, its
                            // on/off toggle and its edit button, leaving a
                            // device you could not name, aim or switch off.
                            property <bool> revoking: d.fp-full != "" && root.confirm-revoke-fp == d.fp-full;
                            property <bool> deleting: d.has-send && root.confirm-delete-handle == d.handle;
                            property <bool> confirming: revoking || deleting;
                            height: 56px;
                            border-radius: Radius.md;
                            opacity: root.connected ? 1.0 : 0.45;
                            drow := TouchArea {}
                            background: drow.has-hover ? Theme.c.surface-raised : transparent;
                            animate background { duration: Motion.fast; }
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.md;
                                VerticalLayout {
                                    alignment: center;
                                    Dot {
                                        // The state is derived once, in
                                        // hops-frontend-core, for both
                                        // frontends; this only colours it
                                        // (#148).
                                        tint: root.tone-color(d.tone);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: d.name;
                                        color: Theme.c.foreground;
                                        font-weight: Type.medium;
                                        overflow: elide;
                                    }
                                    Text {
                                        // send devices show their dial address; a receive-only
                                        // (trusted) peer shows its fingerprint instead
                                        text: d.has-send ? d.addr : d.fingerprint;
                                        color: Theme.c.muted;
                                        font-family: Type.mono;
                                        font-size: Type.caption;
                                        letter-spacing: Type.mono-tracking;
                                        overflow: elide;
                                    }
                                    // The dot alone cannot say WHY: "not
                                    // accepting input", "unreachable" and "it
                                    // removed this machine" need different
                                    // fixes (#92, #144, #184). One
                                    // line, elided, NEVER wrapped: the row is a
                                    // fixed 56px and a wrapped block overflows
                                    // into the row below it.
                                    Text {
                                        text: d.status;
                                        color: root.tone-color(d.tone);
                                        font-size: Type.caption;
                                        font-weight: Type.medium;
                                        overflow: elide;
                                    }
                                }

                                // --- send facet: position + active toggle + edit/delete ---
                                // Not on a machine to pair again (#231): it is
                                // neither crossed to nor dialled for anything
                                // until then, and the room is its status's.
                                if d.has-send && !d.pair-again && !confirming: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: d.pos;
                                        text-color: Theme.c.accent;
                                        fill: Theme.c.accent.transparentize(0.85);
                                        pos-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.reposition-device(d.handle, d.pos == "left" ? "right"
                                                    : d.pos == "right" ? "top"
                                                    : d.pos == "top" ? "bottom" : "left");
                                            }
                                        }
                                    }
                                }
                                if d.has-send && !d.pair-again && !confirming: VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        checked: d.active;
                                        toggled(v) => { root.activate-device(d.handle, v); }
                                    }
                                }
                                // A receive-only trusted peer has no handle, so
                                // the row is keyed by fingerprint instead —
                                // without that, "edit" never rendered for an
                                // inbound peer and it could not be named at all.
                                // Hidden while this row is mid-confirm.
                                // Paired with an older version: adding it
                                // again opens add device, where the pairing
                                // card asks which way control goes (#231).
                                if d.pair-again && !confirming: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "add again";
                                        clicked => {
                                            root.confirm-delete-handle = "";
                                            root.confirm-revoke-fp = "";
                                            if !root.show-add-device {
                                                root.add-device-position = root.free-position;
                                                root.open-pairing();
                                            }
                                            root.show-add-device = true;
                                        }
                                    }
                                }
                                if (d.has-send || d.trusted) && !d.pair-again && !confirming: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "edit";
                                        ghost: true;
                                        clicked => {
                                            root.confirm-clipboard-off = false;
                                            root.editing-pin = d.pin;
                                            root.editing-send = d.has-send;
                                            root.editing-address = "";
                                            root.editing-device = root.editing-device == (d.has-send ? d.handle : d.fp-full)
                                                ? ""
                                                : (d.has-send ? d.handle : d.fp-full);
                                        }
                                    }
                                }
                                // A machine to pair again that has a device
                                // is one card, removed whole by "remove" below.
                                if d.has-send && !d.pair-again && root.confirm-delete-handle != d.handle: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "delete";
                                        ghost: true;
                                        clicked => {
                                            root.confirm-revoke-fp = "";
                                            root.confirm-delete-pin = d.pin;
                                            root.confirm-delete-handle = d.handle;
                                        }
                                    }
                                }
                                if d.has-send && root.confirm-delete-handle == d.handle: VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    // Say what this DOES: this machine forgets
                                    // that one, and using it again means pairing
                                    // the two machines again (#184).
                                    Text {
                                        text: "delete?";
                                        color: Theme.c.muted;
                                        font-size: Type.small;
                                    }
                                    if d.trusted: Text {
                                        text: "to use it again, pair it again";
                                        color: Theme.c.error;
                                        font-size: Type.caption;
                                    }
                                }
                                if d.has-send && root.confirm-delete-handle == d.handle: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "yes";
                                        danger: true;
                                        clicked => {
                                            root.delete-device(d.handle, root.confirm-delete-pin);
                                            root.confirm-delete-handle = "";
                                            root.editing-device = "";
                                        }
                                    }
                                }
                                if d.has-send && root.confirm-delete-handle == d.handle: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "no";
                                        ghost: true;
                                        clicked => { root.confirm-delete-handle = ""; }
                                    }
                                }

                                // --- receive-only facet: revoke ---
                                // NB the handle guard must not fire on receive-only
                                // rows, whose handle is "" — the same as the
                                // default confirm-delete-handle, which silently hid
                                // revoke on every trusted peer.
                                if (d.trusted || d.pair-again) && !revoking
                                    && (d.handle == "" || root.confirm-delete-handle != d.handle): VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: d.pair-again ? "remove" : "revoke";
                                        ghost: true;
                                        clicked => {
                                            root.confirm-delete-handle = "";
                                            root.confirm-revoke-fp = d.fp-full;
                                        }
                                    }
                                }
                                if (d.trusted || d.pair-again) && revoking: VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    // Same words as delete: removing forgets the
                                    // machine, and it returns only by pairing
                                    // again (#184).
                                    Text {
                                        text: "remove?";
                                        color: Theme.c.muted;
                                        font-size: Type.small;
                                    }
                                    Text {
                                        text: "to use it again, pair it again";
                                        color: Theme.c.error;
                                        font-size: Type.caption;
                                    }
                                }
                                if (d.trusted || d.pair-again) && revoking: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "yes";
                                        danger: true;
                                        clicked => {
                                            // Folded with its device (#231): the
                                            // device goes with the listing, as
                                            // one card for one machine.
                                            if d.pair-again && d.has-send {
                                                root.delete-device(d.handle, d.pin);
                                                root.editing-device = "";
                                            } else {
                                                root.revoke(d.fp-full);
                                            }
                                            root.confirm-revoke-fp = "";
                                        }
                                    }
                                }
                                if (d.trusted || d.pair-again) && revoking: VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        text: "no";
                                        ghost: true;
                                        clicked => { root.confirm-revoke-fp = ""; }
                                    }
                                }
                            }
                            // Inert while no daemon is connected: a click would only be refused,
                            // and the row no longer says what is (#34). Last, so it is on top.
                            if !root.connected: TouchArea {}
                        }
                        if root.editing-device != "": Rectangle {
                            background: Theme.c.surface-raised;
                            border-radius: Radius.md;
                            VerticalLayout {
                                padding: Space.md;
                                spacing: Space.sm;
                                // Cancel sits up here, for the whole panel, so
                                // the name and address rows line up (#13).
                                HorizontalLayout {
                                    Text {
                                        text: root.editing-send ? "name" : "rename device";
                                        color: Theme.c.muted;
                                        font-size: Type.caption;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    PillButton {
                                        text: "cancel";
                                        ghost: true;
                                        clicked => {
                                            rename-field.text = "";
                                            root.editing-address = "";
                                            root.editing-device = "";
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Space.sm;
                                    rename-field := TextField {
                                        placeholder: "new name";
                                        horizontal-stretch: 1;
                                        accepted => {
                                            root.rename-device(root.editing-device, root.editing-pin, self.text);
                                            self.text = "";
                                            root.editing-device = "";
                                        }
                                    }
                                    PillButton {
                                        text: "save";
                                        primary: true;
                                        clicked => {
                                            root.rename-device(root.editing-device, root.editing-pin, rename-field.text);
                                            rename-field.text = "";
                                            root.editing-device = "";
                                        }
                                    }
                                }
                                // Where it is dialled, apart from its name (#13).
                                // Outside the `for` below, like the name field,
                                // so the poll tick cannot wipe what is typed.
                                if root.editing-send: Text {
                                    text: root.editing-pin != ""
                                        ? "address — the same machine has to answer there"
                                        : "address";
                                    color: Theme.c.muted;
                                    font-size: Type.caption;
                                }
                                if root.editing-send: HorizontalLayout {
                                    spacing: Space.sm;
                                    TextField {
                                        text <=> root.editing-address;
                                        placeholder: "hostname or IP address";
                                        horizontal-stretch: 1;
                                        accepted => {
                                            root.readdress-device(root.editing-device, root.editing-pin, root.editing-address);
                                            root.editing-address = "";
                                            root.editing-device = "";
                                        }
                                    }
                                    PillButton {
                                        text: "save";
                                        clicked => {
                                            root.readdress-device(root.editing-device, root.editing-pin, root.editing-address);
                                            root.editing-address = "";
                                            root.editing-device = "";
                                        }
                                    }
                                }
                                // The device's clipboard (#182), found in the
                                // fresh `devices` model by the key the edit
                                // button set, so it shows the daemon's latest
                                // word. On offers "turn off", asked first; off
                                // offers "turn on", which the daemon does in
                                // the directions the pairing drives.
                                // One wrapper with no spacing: every device
                                // adds an element here, empty but for the one
                                // being edited.
                                VerticalLayout {
                                    spacing: 0;
                                    for d in root.devices: VerticalLayout {
                                        if d.clipboard != "" && (d.has-send ? d.handle : d.fp-full) == root.editing-device: VerticalLayout {
                                            // The question stands only while
                                            // the clipboard is on: once it is
                                            // off, from any app, the row says so.
                                            property <bool> asking: root.confirm-clipboard-off && d.clipboard-on;
                                            spacing: Space.sm;
                                            Text {
                                                text: "clipboard";
                                                color: Theme.c.muted;
                                                font-size: Type.caption;
                                            }
                                            HorizontalLayout {
                                                spacing: Space.sm;
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text {
                                                        text: asking ? "turn it off?" : d.clipboard;
                                                        color: asking ? Theme.c.warn
                                                            : d.clipboard-on ? Theme.c.foreground : Theme.c.muted;
                                                        font-size: Type.small;
                                                        overflow: elide;
                                                    }
                                                }
                                                if d.clipboard-on && !asking: VerticalLayout {
                                                    alignment: center;
                                                    PillButton {
                                                        text: "turn off";
                                                        ghost: true;
                                                        clicked => { root.confirm-clipboard-off = true; }
                                                    }
                                                }
                                                if !d.clipboard-on: VerticalLayout {
                                                    alignment: center;
                                                    PillButton {
                                                        text: "turn on";
                                                        ghost: true;
                                                        // A question left open
                                                        // from before it went
                                                        // off must not come
                                                        // back once it is on.
                                                        clicked => {
                                                            root.confirm-clipboard-off = false;
                                                            root.enable-clipboard(d.fp-full);
                                                        }
                                                    }
                                                }
                                                if asking: VerticalLayout {
                                                    alignment: center;
                                                    PillButton {
                                                        text: "yes";
                                                        danger: true;
                                                        clicked => {
                                                            root.disable-clipboard(d.fp-full);
                                                            root.confirm-clipboard-off = false;
                                                        }
                                                    }
                                                }
                                                if asking: VerticalLayout {
                                                    alignment: center;
                                                    PillButton {
                                                        text: "no";
                                                        ghost: true;
                                                        clicked => { root.confirm-clipboard-off = false; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }


            }
        }

        // --- footer: theme swatches + device id --------------------------------
        HorizontalLayout {
            spacing: Space.sm;
            VerticalLayout {
                alignment: center;
                Text { text: "theme"; color: Theme.c.muted; font-size: Type.caption; }
            }
            for pal[i] in Theme.palettes: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: self.width / 2;
                    background: pal.accent;
                    border-width: i == Theme.index ? 2px : 0px;
                    border-color: Theme.c.foreground;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.set-theme(i); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.fingerprint;
                    color: Theme.c.muted;
                    font-family: Type.mono;
                    font-size: Type.caption;
                    letter-spacing: Type.mono-tracking;
                    overflow: elide;
                }
            }
        }
    }

    // --- settings overlay (a sibling of the root layout so it floats above it) --
    if root.show-settings: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        TouchArea { clicked => { root.show-settings = false; } }

        Rectangle {
            width: 320px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.c.surface;
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Theme.c.border;

            TouchArea {} // swallows clicks so the panel doesn't close itself

            VerticalLayout {
                padding: Space.xxl;
                spacing: Space.md;
                Text {
                    text: "settings";
                    font-size: Type.heading;
                    font-weight: Type.bold;
                    color: Theme.c.foreground;
                }
                VerticalLayout {
                    spacing: 6px;
                    SectionTitle { text: "interface"; color: Theme.c.accent; }
                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        PillButton { text: "graphical"; primary: true; enabled: false; }
                        if root.can-switch-interface: PillButton {
                            text: "terminal";
                            clicked => { root.switch-interface(); }
                        }
                    }
                    if !root.can-switch-interface: Text {
                        text: "for the terminal interface, run hops tui in a terminal";
                        color: Theme.c.muted;
                        font-size: Type.caption;
                        wrap: word-wrap;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                PillButton {
                    text: "close";
                    ghost: true;
                    clicked => { root.show-settings = false; }
                }
            }
        }
    }

    // --- layout canvas overlay ---------------------------------------------
    if root.show-layout-canvas: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        TouchArea { clicked => { root.show-layout-canvas = false; } }

        LayoutCanvas {
            width: 560px;
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            boxes: root.canvas-boxes;
            close => { root.show-layout-canvas = false; }
            geometry-changed(handle, x, y) => { root.update-device-geometry(handle, x, y); }
        }
    }
}
