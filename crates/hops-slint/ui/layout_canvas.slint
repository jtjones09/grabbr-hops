// hops — the drag-to-arrange layout canvas (#174). Where a device is
// dropped sets the edge of this machine its pointer crosses at: Rust works
// the edge out from the drop (src/canvas.rs), asks the daemon to move the
// device there, and draws every device at a clean spot on its edge's side,
// so the picture never shows a place the crossing does not honour.
//
// The boxes are redrawn only when the devices they show change (added,
// removed, renamed, switched, moved to another edge), not on every poll:
// a redraw ends a drag in progress.

import { Theme, Type, Space, Radius, Motion } from "theme.slint";
import { PillButton } from "widgets.slint";

export struct CanvasBox {
    handle: string,
    name: string,
    // logical px, plain floats (not `length`) so Rust can construct/read this
    // struct without needing Slint's length wrapper type.
    x: float,
    y: float,
    // switched on: the device the pointer crosses to at this edge
    active: bool,
}

// shared constants — Slint has no top-level `const`, only `global` (the same
// idiom theme.slint uses for Space/Radius/etc.)
global CanvasSize {
    out property <length> width: 480px;
    out property <length> height: 280px;
    out property <length> box-width: 96px;
    out property <length> box-height: 64px;
}

component DraggableBox inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in-out property <length> box-x;
    in-out property <length> box-y;
    callback dropped(length /* x */, length /* y */);

    width: CanvasSize.box-width;
    height: CanvasSize.box-height;
    x: box-x;
    y: box-y;
    // opaque, so a box drawn over another hides it cleanly; the tint is a
    // layer on top
    background: root.active ? Theme.c.background : Theme.c.surface;
    border-width: 2px;
    border-color: root.active ? Theme.c.accent : Theme.c.border;
    border-radius: Radius.md;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.active ? "" : "switched off";

    Rectangle {
        border-radius: Radius.md;
        background: ta.pressed ? Theme.c.accent.transparentize(0.55)
            : root.active ? Theme.c.accent.transparentize(0.75) : transparent;
        animate background { duration: Motion.fast; }
    }

    VerticalLayout {
        alignment: center;
        padding-left: Space.xs;
        padding-right: Space.xs;
        Text {
            text: root.label;
            color: root.active ? Theme.c.foreground : Theme.c.muted;
            font-size: Type.small;
            font-weight: Type.semibold;
            horizontal-alignment: center;
            overflow: elide;
        }
        if !root.active: Text {
            text: "off";
            color: Theme.c.muted;
            font-size: Type.caption;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        property <length> pressed-box-x;
        property <length> pressed-box-y;
        mouse-cursor: pointer;

        // the down/up-detecting drag idiom is Slint's own — mirrors the
        // built-in SliderBase widget (i-slint-compiler's widgets/common/
        // slider-base.slint), the proven reference for this exact pattern.
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.pressed-box-x = root.box-x;
                self.pressed-box-y = root.box-y;
            } else if (event.kind == PointerEventKind.up) {
                root.dropped(root.box-x, root.box-y);
            }
        }
        moved => {
            root.box-x = max(0px, min(CanvasSize.width - CanvasSize.box-width, self.pressed-box-x + (self.mouse-x - self.pressed-x)));
            root.box-y = max(0px, min(CanvasSize.height - CanvasSize.box-height, self.pressed-box-y + (self.mouse-y - self.pressed-y)));
        }
    }
}

export component LayoutCanvas inherits Rectangle {
    in property <[CanvasBox]> boxes: [];
    // names of paired machines with no device here, so nothing to place
    in property <string> unplaced;
    in property <string> this-name;
    in property <string> this-kind;
    callback close();
    // a box's top-left corner where it was dropped, in plain logical-px
    // floats — see CanvasBox's own note on why.
    callback dropped(string /* handle */, float /* x */, float /* y */);

    background: Theme.c.surface;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Theme.c.border;

    // declared BEFORE the real content below, so it only catches clicks on
    // empty panel background (later siblings win hit-testing) — stops a click
    // inside the panel from falling through to the outer scrim's close-on-
    // click-outside handler, same pattern the settings overlay uses.
    TouchArea {}

    VerticalLayout {
        padding: Space.xxl;
        spacing: Space.md;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "arrange devices";
                font-size: Type.heading;
                font-weight: Type.bold;
                color: Theme.c.foreground;
                vertical-alignment: center;
            }
            PillButton {
                text: "done";
                primary: true;
                clicked => { root.close(); }
            }
        }
        Text {
            text: "Drag each device to the side of this machine it sits on: the pointer crosses to it through that edge. Two switched-on devices swap sides when one is dropped on the other's; a switched-off one sits beside.";
            color: Theme.c.muted;
            font-size: Type.caption;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: CanvasSize.width;
                height: CanvasSize.height;
                background: Theme.c.background;
                border-radius: Radius.md;
                border-width: 1px;
                border-color: Theme.c.border;

                // this machine — a fixed anchor, not draggable: the edges
                // are its own, and every device is placed around it.
                Rectangle {
                    width: CanvasSize.box-width;
                    height: CanvasSize.box-height;
                    x: (CanvasSize.width - self.width) / 2;
                    y: (CanvasSize.height - self.height) / 2;
                    background: Theme.c.surface-raised;
                    border-width: 2px;
                    border-color: Theme.c.muted;
                    border-radius: Radius.md;
                    VerticalLayout {
                        alignment: center;
                        padding-left: Space.xs;
                        padding-right: Space.xs;
                        if root.this-name != "": Text {
                            text: root.this-name;
                            color: Theme.c.foreground;
                            font-size: Type.small;
                            font-weight: Type.semibold;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.this-kind;
                            color: root.this-name != "" ? Theme.c.muted : Theme.c.foreground;
                            font-size: root.this-name != "" ? Type.caption : Type.small;
                            font-weight: root.this-name != "" ? Type.regular : Type.semibold;
                            horizontal-alignment: center;
                        }
                    }
                }

                for b in root.boxes: DraggableBox {
                    label: b.name;
                    active: b.active;
                    box-x: b.x * 1px;
                    box-y: b.y * 1px;
                    dropped(x, y) => { root.dropped(b.handle, x / 1px, y / 1px); }
                }
            }
        }
        if root.unplaced != "": Text {
            text: "Not shown: " + root.unplaced + ". Paired, but with no address here yet, so there is no edge to set; each appears once it connects to this machine.";
            color: Theme.c.muted;
            font-size: Type.caption;
            wrap: word-wrap;
        }
    }
}
